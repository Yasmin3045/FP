<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="PLATOS DE COMIDA"/>
        <attribute name="authors" value="Hp"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-23 09:05:02 p.m."/>
        <attribute name="created" value="SHA7REVTS1RPUC1KOFFMMUdMOzIwMjYtMDQtMjM7MDc6NTc6MzQgcC5tLjsyNjk1"/>
        <attribute name="edited" value="SHA7REVTS1RPUC1KOFFMMUdMOzIwMjYtMDQtMjM7MDk6MDU6MDIgcC5tLjsxOzI3OTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <home/>
            <declare name="CANTIDAD, TOTAL" type="Integer" array="False" size=""/>
            <input variable="CANTIDAD"/>
            <if expression="CANTIDAD&gt;200">
                <then>
                    <if expression="CANTIDAD&gt;300">
                        <then>
                            <assign variable="TOTAL" expression="CANTIDAD*10000"/>
                        </then>
                        <else>
                            <assign variable="TOTAL" expression="CANTIDAD*15000"/>
                        </else>
                    </if>
                </then>
                <else>
                    <assign variable="TOTAL" expression="CANTIDAD*200"/>
                </else>
            </if>
            <output expression="TOTAL" newline="True"/>
        </body>
    </function>
</flowgorithm>
