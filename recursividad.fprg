    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="" type="Integer" array="False" size=""/>
        </body>
    </function>
    <function name="SumaNNumeros" type="None" variable="Numeros">
        <parameters>
            <parameter name="Numero" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="suma" type="Integer" array="False" size=""/>
            <if expression="Numero==1">
                <then>
                    <assign variable="Suma" expression="1"/>
                </then>
                <else>
                    <assign variable="Suma" expression="Numero+SumaNNumeros(Numero-1)"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
