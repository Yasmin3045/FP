    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <home/>
            <declare name="TotalenPesos, Tazacambio, ValorcompraenDolar" type="Integer" array="False" size=""/>
            <input variable="Tazacambio"/>
            <input variable="ValorcompraenDolar"/>
