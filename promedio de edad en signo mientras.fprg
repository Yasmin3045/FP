<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="promedio de edad en signo mientras"/>
        <attribute name="authors" value="Hp"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-14 07:40:40 p.m."/>
        <attribute name="created" value="SHA7REVTS1RPUC1KOFFMMUdMOzIwMjYtMDUtMTQ7MDY6MzM6MTMgcC5tLjsyNjg2"/>
        <attribute name="edited" value="SHA7REVTS1RPUC1KOFFMMUdMOzIwMjYtMDUtMTQ7MDc6NDA6NDAgcC5tLjsxOzI3OTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, cantidad, suma, promedio, edad" type="Integer" array="False" size=""/>
            <input variable="cantidad"/>
            <assign variable="i" expression="1"/>
            <assign variable="suma" expression="0"/>
            <while expression="i&lt;cantidad">
                <input variable="edad"/>
                <assign variable="suma" expression="suma+edad"/>
                <assign variable="i" expression="i+1"/>
            </while>
            <assign variable="promedio" expression="suma/cantidad"/>
            <output expression="promedio" newline="True"/>
        </body>
    </function>
</flowgorithm>
